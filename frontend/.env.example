# =============================================================================
# TTB Label Validator — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values for local development.
# Vercel deployments use the Vercel Environment Variables dashboard instead.
#
#   cp .env.example .env.local
#
# None of these are required for the core UI to run — features degrade
# gracefully when their backing service is unavailable.
# =============================================================================

# ---------------------------------------------------------------------------
# OpenRouter (AI OCR + Explain)
# ---------------------------------------------------------------------------
# API key from https://openrouter.ai — powers Tier 2 AI Extract (Claude 3.5
# Sonnet) and the regulation explanation feature.
OPENROUTER_API_KEY=

# Model override (default: anthropic/claude-3.5-sonnet)
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Set to "true" to enable the server-side AI OCR endpoint (/api/ocr).
# When "false" or unset, the endpoint returns a graceful "disabled" response.
OCR_ENABLED=true

# Set to "false" to explicitly disable the explain endpoint (/api/explain).
# When unset, the endpoint is enabled if OPENROUTER_API_KEY is present.
# EXPLAIN_ENABLED=false

# ---------------------------------------------------------------------------
# Gemini (AI Label Generator)
# ---------------------------------------------------------------------------
# API key from https://aistudio.google.com — powers /api/generate-label.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# AWS Lambda Flatten (server-side OpenCV)
# ---------------------------------------------------------------------------
# Set to "true" to enable the /api/flatten proxy to the Lambda function.
FLATTEN_ENABLED=false

# Full URL of the deployed Lambda (e.g. https://xxx.execute-api.us-east-1.amazonaws.com/prod/flatten)
# FLATTEN_LAMBDA_URL=

# ---------------------------------------------------------------------------
# Browser-side feature flags (NEXT_PUBLIC_ prefix = exposed to client)
# ---------------------------------------------------------------------------
# Set to "true" to enable Tesseract.js Quick Check in the browser.
NEXT_PUBLIC_TESSERACT_ENABLED=true
